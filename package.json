  "devDependencies": {
    "@types/node": "^25.6.0",
    "astro": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/astro-shopsavvy"
