{
  "name": "astro-shopsavvy",
  "version": "1.0.0",
  "description": "Astro integration for ShopSavvy product search, price comparison, and deal discovery",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
